<Window
    x:Class="ASTEM_DB.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:color="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ASTEM_DB.ViewModels"
    xmlns:converters="clr-namespace:ASTEM_DB.Converters"
    x:Name="rootWindow"
    Title="ASTEM DB"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.aiHeader">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE3E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.aiChat">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="#EEF2F4" />
            <Setter Property="BorderBrush" Value="#DCE3E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.chatBubble">
            <Setter Property="MaxWidth" Value="285" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.chatBubble.assistant">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DEE3" />
        </Style>
        <Style Selector="Border.chatBubble.user">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Background" Value="#176B87" />
            <Setter Property="BorderBrush" Value="#176B87" />
        </Style>
        <Style Selector="Border.chatBubble.assistant TextBlock">
            <Setter Property="Foreground" Value="#20272B" />
        </Style>
        <Style Selector="Border.chatBubble.user TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="TextBlock.chatSender">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="DemiBold" />
            <Setter Property="Opacity" Value="0.78" />
        </Style>
        <Style Selector="Border.aiComposer">
            <Setter Property="Padding" Value="9" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TextBox.aiPrompt">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.aiButton">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.aiButton.primary">
            <Setter Property="Background" Value="#176B87" />
            <Setter Property="BorderBrush" Value="#176B87" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="DemiBold" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="400,*,200" RowDefinitions="*">

        <!--  Left Sidebar  -->
        <Border
            Grid.Column="0"
            Background="#F0F0F0"
            BorderBrush="#F0F0F0"
            BorderThickness="0,0,1,0"
            CornerRadius="0">
            <TabControl Margin="10" SelectedIndex="0">
                <TabItem
                    FontSize="20"
                    FontWeight="DemiBold"
                    Header="Glaze Search">
                    <ScrollViewer Margin="0,30,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10" Spacing="5">
                            <color:ColorView
                                Margin="0,-10,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsAlphaVisible="False"
                                IsColorComponentsVisible="False"
                                IsColorModelVisible="False"
                                IsColorPaletteVisible="False"
                                IsColorPreviewVisible="True"
                                IsColorSpectrumVisible="True"
                                IsComponentSliderVisible="False"
                                Color="{Binding SelectedColor, Mode=TwoWay}" />

                            <RadioButton
                                Content="Filter using Spectrum"
                                GroupName="ColorMode"
                                IsChecked="{Binding FilterByColor}" />
                            <RadioButton
                                Content="Filter using Name"
                                GroupName="ColorMode"
                                IsChecked="{Binding FilterByString}" />
                            <RadioButton
                                Content="Don't Filter with Color"
                                GroupName="ColorMode"
                                IsChecked="{Binding DontFilterByColor}" />

                            <TextBlock Margin="0,0,0,0" Text="Glaze Type" />
                            <ComboBox ItemsSource="{Binding GlazeTypes}" SelectedItem="{Binding SelectedGlazeType, Mode=TwoWay}" />

                            <TextBlock Margin="0,0,0,0" Text="Surface Condition" />
                            <ComboBox ItemsSource="{Binding SurfaceConditions}" SelectedItem="{Binding SelectedSurfaceCondition, Mode=TwoWay}" />
                            <TextBlock Margin="0,0,0,0" Text="Firing Atmosphere" />
                            <ComboBox
                                Width="150"
                                ItemsSource="{Binding FiringTypes}"
                                SelectedItem="{Binding SelectedFiringType, Mode=TwoWay}" />
                            <TextBlock Margin="0,0,0,0" Text="Color Name" />
                            <ComboBox ItemsSource="{Binding ColorPalettes}" SelectedItem="{Binding SelectedColorPalette, Mode=TwoWay}" />
                            <Button
                                Width="100"
                                HorizontalAlignment="Right"
                                Command="{Binding SearchCommand}"
                                Content="Search" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem
                    FontSize="20"
                    FontWeight="DemiBold"
                    Header="AI Search">
                    <Grid
                        Margin="10,24,10,10"
                        Background="#F5F7F8"
                        RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" Classes="aiHeader">
                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border
                                            Width="8"
                                            Height="8"
                                            VerticalAlignment="Center"
                                            Background="#D9843B"
                                            CornerRadius="4" />
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="DemiBold"
                                            Text="Find with AI" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="#5F6B72"
                                        Text="{Binding AiStrictnessLabel}" />
                                </Grid>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#46545C"
                                    Text="{Binding AiSearchStatus}"
                                    TextWrapping="Wrap" />
                                <ProgressBar
                                    Height="3"
                                    IsIndeterminate="True"
                                    IsVisible="{Binding IsAiSearchLoading}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Margin="0,10"
                            Classes="aiChat">
                            <ScrollViewer
                                x:Name="AiChatScrollViewer"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AiChatMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AiChatMessageViewModel">
                                            <Border
                                                Classes.assistant="{Binding IsFromAssistant}"
                                                Classes.user="{Binding IsFromUser}"
                                                Classes="chatBubble">
                                                <StackPanel Spacing="3">
                                                    <TextBlock
                                                        Classes="chatSender"
                                                        Text="{Binding Sender}" />
                                                    <TextBlock
                                                        FontSize="13"
                                                        Text="{Binding Message}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Classes="aiComposer">
                            <StackPanel Spacing="6">
                                <TextBox
                                    AcceptsReturn="True"
                                    Classes="aiPrompt"
                                    Text="{Binding AiSearchPrompt, Mode=TwoWay}"
                                    TextWrapping="Wrap"
                                    Watermark="Describe the tile you want..." />
                                <Border 
                                    Width="72"
                                    Height="72"
                                    HorizontalAlignment="Left"
                                    BorderBrush="#CBD5DB"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    IsVisible="{Binding AiSearchImagePath, Converter={x:Static converters:StringNotEmptyConverter.Instance}}">
                                    <Image
                                        Margin="2"
                                        Source="{Binding AiSearchImagePath, Converter={x:Static converters:PathToBitmapConverter.Instance}}"
                                        Stretch="UniformToFill" />
                                </Border>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#65737A"
                                    Text="{Binding AiSearchImageLabel}"
                                    TextTrimming="CharacterEllipsis" />

                                <StackPanel Spacing="2">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="DemiBold"
                                            Foreground="#46545C"
                                            Text="Match strictness" />
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            FontSize="11"
                                            Foreground="#176B87"
                                            Text="{Binding AiMinimumMatchPercent, StringFormat={}{0}% minimum}" />
                                    </Grid>
                                    <Slider
                                        Minimum="0"
                                        Maximum="2"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding AiStrictnessLevelIndex, Mode=TwoWay}" />
                                    <Grid ColumnDefinitions="*,*,*">
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="#65737A"
                                            Text="Loose" />
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            FontSize="10"
                                            Foreground="#65737A"
                                            Text="Balanced" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            FontSize="10"
                                            Foreground="#65737A"
                                            Text="Strict" />
                                    </Grid>
                                </StackPanel>

                                <Grid ColumnDefinitions="Auto,Auto,*">
                                    <Button
                                        Grid.Column="0"
                                        Classes="aiButton"
                                        Click="OnAiImageButtonClicked"
                                        Content="Search image"
                                        ToolTip.Tip="Choose a tile image" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Classes="aiButton"
                                        Command="{Binding ResetAiConversationCommand}"
                                        Content="Reset" />
                                    <Button
                                        Grid.Column="2"
                                        MinWidth="88"
                                        HorizontalAlignment="Right"
                                        Classes="aiButton primary"
                                        Command="{Binding AiSearchCommand}"
                                        Content="Search" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!--  Main Content Area  -->
        <Grid
            Grid.Column="1"
            Margin="20"
            Background="#FFFFFF"
            RowDefinitions="*,Auto">
            <TextBlock IsVisible="{Binding IsFilterEmpty}" Text="NO GLAZES FOUND" />

            <!--  Image Grid  -->
            <ScrollViewer Margin="0,40,0,0" VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding CardItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="160"
                                Height="185"
                                Margin="10,10,0,0"
                                Background="#FFFFFF"
                                Click="OnCardClicked">
                                <StackPanel>
                                    <Border
                                        Width="150"
                                        Height="150"
                                        Margin="5"
                                        BorderBrush="Gray"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Image
                                            Width="120"
                                            Height="120"
                                            Source="{Binding Image}" />
                                    </Border>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Text="{Binding AiScoreString}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>

                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
        <!--  Card Info Sidebar  -->
        <Border
            Grid.Column="2"
            Margin="5"
            Background="#F0F0F0"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="6"
            IsVisible="{Binding IsSidebarVisible}">

            <DockPanel Width="200">
                <StackPanel
                    Margin="10"
                    HorizontalAlignment="Center"
                    DockPanel.Dock="Top"
                    Spacing="5">
                    <Image
                        Width="130"
                        Height="130"
                        Source="{Binding SelectedCard.Image}" />
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Glaze Type"  />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="{Binding SelectedCard.GlazeType}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Firing Type" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="{Binding SelectedCard.FiringType}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Soil Type" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="{Binding SelectedCard.SoilType}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Surface Condition" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="{Binding SelectedCard.SurfaceCondition}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Chemical Composition" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="{Binding SelectedCard.ChemicalComposition}" />
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Color" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="{Binding SelectedCard.ColorName}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Auto Tags" />
                    </TextBlock>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{Binding SelectedCard.AutoTags}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Auto Keywords" />
                    </TextBlock>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{Binding SelectedCard.AutoKeywords}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border
                        Margin="0,8,0,0"
                        Padding="8"
                        Background="#FFFFFF"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Spacing="6">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontWeight="DemiBold"
                                Text="AI Training" />
                            <TextBlock
                                FontSize="11"
                                Text="{Binding SelectedCard.AiFeedbackStatus}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <UniformGrid Columns="2" Rows="2">
                                <Button
                                    Margin="2"
                                    Command="{Binding MarkAiGoodCommand}"
                                    Content="Good" />
                                <Button
                                    Margin="2"
                                    Command="{Binding MarkAiBadCommand}"
                                    Content="Bad" />
                                <Button
                                    Margin="2"
                                    Command="{Binding MarkAiWrongColorCommand}"
                                    Content="Color" />
                                <Button
                                    Margin="2"
                                    Command="{Binding MarkAiHasDarkEdgesCommand}"
                                    Content="Edges" />
                            </UniformGrid>
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{Binding TrainAiRankingCommand}"
                                Content="Train Weights" />
                            <TextBlock
                                FontSize="11"
                                Text="{Binding AiTrainingStatus}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <!-- <TextBlock Text="{Binding SelectedCard.ImagePath}"/> -->
                    <!-- <TextBlock Text="{Binding SelectedCard.Lab}" /> -->

                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>

</Window>
