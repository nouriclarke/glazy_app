<Window
    x:Class="ASTEM_DB.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:color="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ASTEM_DB.ViewModels"
    x:Name="rootWindow"
    Title="ASTEM DB"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <Grid ColumnDefinitions="400,*,200" RowDefinitions="*">

        <!--  Left Sidebar  -->
        <Border
            Grid.Column="0"
            Background="#F0F0F0"
            BorderBrush="#F0F0F0"
            BorderThickness="0,0,1,0"
            CornerRadius="0">
            <TabControl Margin="10" SelectedIndex="0">
                <TabItem
                    FontSize="20"
                    FontWeight="DemiBold"
                    Header="Glaze Search">
                    <ScrollViewer Margin="0,30,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10" Spacing="5">
                            <color:ColorView
                                Margin="0,-10,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsAlphaVisible="False"
                                IsColorComponentsVisible="False"
                                IsColorModelVisible="False"
                                IsColorPaletteVisible="False"
                                IsColorPreviewVisible="True"
                                IsColorSpectrumVisible="True"
                                IsComponentSliderVisible="False"
                                Color="{Binding SelectedColor, Mode=TwoWay}" />

                            <RadioButton
                                Content="Filter using Spectrum"
                                GroupName="ColorMode"
                                IsChecked="{Binding FilterByColor}" />
                            <RadioButton
                                Content="Filter using Name"
                                GroupName="ColorMode"
                                IsChecked="{Binding FilterByString}" />
                            <RadioButton
                                Content="Don't Filter with Color"
                                GroupName="ColorMode"
                                IsChecked="{Binding DontFilterByColor}" />

                            <TextBlock Margin="0,0,0,0" Text="Glaze Type" />
                            <ComboBox ItemsSource="{Binding GlazeTypes}" SelectedItem="{Binding SelectedGlazeType, Mode=TwoWay}" />

                            <TextBlock Margin="0,0,0,0" Text="Surface Condition" />
                            <ComboBox ItemsSource="{Binding SurfaceConditions}" SelectedItem="{Binding SelectedSurfaceCondition, Mode=TwoWay}" />
                            <TextBlock Margin="0,0,0,0" Text="Firing Atmosphere" />
                            <ComboBox
                                Width="150"
                                ItemsSource="{Binding FiringTypes}"
                                SelectedItem="{Binding SelectedFiringType, Mode=TwoWay}" />
                            <TextBlock Margin="0,0,0,0" Text="Color Name" />
                            <ComboBox ItemsSource="{Binding ColorPalettes}" SelectedItem="{Binding SelectedColorPalette, Mode=TwoWay}" />
                            <Button
                                Width="100"
                                HorizontalAlignment="Right"
                                Command="{Binding SearchCommand}"
                                Content="Search" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem
                    FontSize="20"
                    FontWeight="DemiBold"
                    Header="AI Search">
                    <Grid Margin="10,30,10,10" RowDefinitions="Auto,*,Auto,Auto,Auto">
                        <StackPanel Grid.Row="0" Spacing="6">
                            <TextBlock
                                FontSize="14"
                                FontWeight="DemiBold"
                                Text="AI Chat Search" />
                            <TextBlock
                                Text="{Binding AiSearchStatus}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontStyle="Italic"
                                Text="{Binding AiResolvedSearchPrompt}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12"
                                Text="{Binding AiSearchImageLabel}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Border
                            Grid.Row="1"
                            Margin="0,12,0,8"
                            Padding="8"
                            Background="#FFFFFF"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AiChatMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AiChatMessageViewModel">
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="8"
                                                Background="#F8F8F8"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                                <StackPanel Spacing="3">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="DemiBold"
                                                        Text="{Binding Sender}" />
                                                    <TextBlock
                                                        Text="{Binding Message}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBox
                            Grid.Row="2"
                            MinHeight="78"
                            AcceptsReturn="True"
                            Text="{Binding AiSearchPrompt, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            Watermark="give me something brown" />

                        <Grid Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="*,Auto,Auto,Auto">
                            <ProgressBar
                                Grid.Column="0"
                                Height="6"
                                VerticalAlignment="Center"
                                IsIndeterminate="True"
                                IsVisible="{Binding IsAiSearchLoading}" />
                            <Button
                                Grid.Column="1"
                                Width="76"
                                Margin="8,0,0,0"
                                Click="OnAiImageButtonClicked"
                                Content="Image"
                                ToolTip.Tip="Attach an image for visual search" />
                            <Button
                                Grid.Column="2"
                                Width="76"
                                Margin="8,0,0,0"
                                Command="{Binding ResetAiConversationCommand}"
                                Content="Reset" />
                            <Button
                                Grid.Column="3"
                                Width="96"
                                Margin="8,0,0,0"
                                Command="{Binding AiSearchCommand}"
                                Content="Send" />
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!--  Main Content Area  -->
        <Grid
            Grid.Column="1"
            Margin="20"
            Background="#FFFFFF"
            RowDefinitions="*,Auto">
            <TextBlock IsVisible="{Binding IsFilterEmpty}" Text="NO GLAZES FOUND" />

            <!--  Image Grid  -->
            <ScrollViewer Margin="0,40,0,0" VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding CardItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="160"
                                Height="185"
                                Margin="10,10,0,0"
                                Background="#FFFFFF"
                                Click="OnCardClicked">
                                <StackPanel>
                                    <Border
                                        Width="150"
                                        Height="150"
                                        Margin="5"
                                        BorderBrush="Gray"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Image
                                            Width="120"
                                            Height="120"
                                            Source="{Binding Image}" />
                                    </Border>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Text="{Binding AiScoreString}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>

                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
        <!--  Card Info Sidebar  -->
        <Border
            Grid.Column="2"
            Margin="5"
            Background="#F0F0F0"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="6"
            IsVisible="{Binding IsSidebarVisible}">

            <DockPanel Width="200">
                <StackPanel
                    Margin="10"
                    HorizontalAlignment="Center"
                    DockPanel.Dock="Top"
                    Spacing="5">
                    <Image
                        Width="130"
                        Height="130"
                        Source="{Binding SelectedCard.Image}" />
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Glaze Type"  />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="{Binding SelectedCard.GlazeType}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Firing Type" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="{Binding SelectedCard.FiringType}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Soil Type" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="{Binding SelectedCard.SoilType}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Surface Condition" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="{Binding SelectedCard.SurfaceCondition}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Chemical Composition" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="{Binding SelectedCard.ChemicalComposition}" />
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Color" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="{Binding SelectedCard.ColorName}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Auto Tags" />
                    </TextBlock>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{Binding SelectedCard.AutoTags}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Auto Keywords" />
                    </TextBlock>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{Binding SelectedCard.AutoKeywords}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border
                        Margin="0,8,0,0"
                        Padding="8"
                        Background="#FFFFFF"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Spacing="6">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontWeight="DemiBold"
                                Text="AI Training" />
                            <TextBlock
                                FontSize="11"
                                Text="{Binding SelectedCard.AiFeedbackStatus}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <UniformGrid Columns="2" Rows="2">
                                <Button
                                    Margin="2"
                                    Command="{Binding MarkAiGoodCommand}"
                                    Content="Good" />
                                <Button
                                    Margin="2"
                                    Command="{Binding MarkAiBadCommand}"
                                    Content="Bad" />
                                <Button
                                    Margin="2"
                                    Command="{Binding MarkAiWrongColorCommand}"
                                    Content="Color" />
                                <Button
                                    Margin="2"
                                    Command="{Binding MarkAiHasDarkEdgesCommand}"
                                    Content="Edges" />
                            </UniformGrid>
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{Binding TrainAiRankingCommand}"
                                Content="Train Weights" />
                            <TextBlock
                                FontSize="11"
                                Text="{Binding AiTrainingStatus}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <!-- <TextBlock Text="{Binding SelectedCard.ImagePath}"/> -->
                    <!-- <TextBlock Text="{Binding SelectedCard.Lab}" /> -->

                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>

</Window>
